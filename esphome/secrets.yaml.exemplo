# Copie este arquivo para secrets.yaml (mesma pasta) e preencha.
# O secrets.yaml fica só no seu computador: ele está no .gitignore.

# Rede Wi-Fi da casa (2,4 GHz).
wifi_ssid: "NomeDaRede"
wifi_senha: "SenhaDaRede"

# PanelAI → Configurações → Tela e-ink → "Copiar para o secrets.yaml".
# É a chave para ver a imagem: guarde só aqui.
panelai_endereco: "https://brunoalmeida87.github.io/PanelAI/tela/COLE_AQUI_O_CODIGO"
