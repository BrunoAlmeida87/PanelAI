rules_version = '2';

// Regras de segurança do PanelAI no Firestore.
// Copie este arquivo inteiro em: Firebase → Firestore Database → Regras → Publicar.
//
// Quem pode o quê:
//  - Só pessoas logadas com e-mail confirmado.
//  - Uma "casa" (households/{casa}) lista os e-mails que podem acessá-la (memberEmails).
//  - Só o responsável (ownerEmail) adiciona ou remove pessoas.
//  - Todas as pessoas da casa leem e alteram cardápio, receitas, despensa etc.
//  - Ninguém de fora da lista vê nada.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function isMember(casa) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/households/$(casa)).data.memberEmails;
    }

    function validHousehold(d) {
      return d.keys().hasOnly(['name', 'ownerEmail', 'memberEmails', 'createdAt'])
        && d.name is string && d.name.size() <= 60
        && d.memberEmails is list && d.memberEmails.size() <= 10
        && d.ownerEmail in d.memberEmails;
    }

    match /households/{casa} {
      allow read: if signedIn() && myEmail() in resource.data.memberEmails;

      allow create: if signedIn()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberEmails == [myEmail()]
        && validHousehold(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerEmail == myEmail()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && validHousehold(request.resource.data);

      allow delete: if false;

      // Dados do app: um documento por registro, com o JSON em "v".
      match /{colecao}/{id} {
        allow read: if isMember(casa)
          && colecao in ['ingredients', 'recipes', 'pantry', 'weeks', 'marmitas', 'movements', 'purchases', 'meta'];

        allow delete: if isMember(casa)
          && colecao in ['ingredients', 'recipes', 'pantry', 'weeks', 'marmitas', 'movements', 'purchases', 'meta'];

        allow create, update: if isMember(casa)
          && colecao in ['ingredients', 'recipes', 'pantry', 'weeks', 'marmitas', 'movements', 'purchases', 'meta']
          && request.resource.data.keys().hasOnly(['v', 't', 'by'])
          && request.resource.data.v is string
          && request.resource.data.v.size() < 1000000
          && request.resource.data.by == myEmail()
          && request.resource.data.t == request.time;
      }
    }
  }
}
