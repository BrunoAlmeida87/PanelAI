{
  "name": "panelai",
  "private": true,
  "version": "1.4.0",
  "description": "PanelAI — planejamento de refeições, receitas, lista de compras e despensa.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:cloud": "npx --yes firebase-tools@15.36.0 emulators:exec --only auth,firestore --project demo-panelai \"node tests/cloud/run-cloud.mjs && node tests/cloud/run-login.mjs && node tests/cloud/run-display.mjs\"",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "display:png": "node scripts/display-png.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^13.3.0",
    "lucide-preact": "^1.70.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
